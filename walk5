local ROAD = "minecraft:polished_andesite"
local DELAY = 0.15

local function roadBelow()
    local ok, data = turtle.inspectDown()
    return ok and data and data.name == ROAD
end

local function fuelOK()
    local fuel = turtle.getFuelLevel()
    if fuel == "unlimited" then
        return true
    end
    if fuel <= 0 then
        print("NO FUEL")
        print("Add fuel to the turtle.")
        return false
    end
    return true
end

-- Try one actual step. If the new block is not road,
-- immediately return to the previous block.
local function stepIfRoad()
    if turtle.detect() then
        return false
    end

    local ok, err = turtle.forward()
    if not ok then
        print("MOVE FAILED: " .. tostring(err))
        return false
    end

    sleep(0.05)

    if roadBelow() then
        return true
    end

    turtle.back()
    sleep(0.05)
    return false
end

local function tryRight()
    turtle.turnRight()
    sleep(0.05)
    return stepIfRoad()
end

local function tryLeft()
    turtle.turnLeft()
    sleep(0.05)
    return stepIfRoad()
end

term.clear()
term.setCursorPos(1, 1)
print("WALK5 - ROAD WALKER")
print("Road: polished andesite")
print("--------------------")

if not fuelOK() then
    return
end

if not roadBelow() then
    print("ERROR: NOT ON ROAD")
    print("Place turtle on polished andesite.")
    return
end

print("ROAD FOUND")
print("WALKING...")
sleep(1)

while true do
    if not fuelOK() then
        break
    end

    -- 1. Keep going straight whenever possible.
    if stepIfRoad() then
        sleep(DELAY)
    else
        -- 2. Obstacle or end of this direction.
        -- Try right once.
        if tryRight() then
            sleep(DELAY)
        else
            -- 3. Right failed. Turn left twice from the right-facing
            -- direction. This puts us facing left relative to the original.
            turtle.turnLeft()
            turtle.turnLeft()
            sleep(0.05)

            if stepIfRoad() then
                sleep(DELAY)
            else
                -- 4. Left also failed. Turn right once to restore the
                -- original direction, then turn around and test backwards.
                turtle.turnRight()
                turtle.turnRight()
                sleep(0.05)

                if stepIfRoad() then
                    sleep(DELAY)
                else
                    print("ROAD ENDED")
                    print("No reachable road block.")
                    break
                end
            end
        end
    end
end
