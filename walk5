local ROAD = "minecraft:polished_andesite"
local heading = 0

local function right()
    turtle.turnRight()
    heading = (heading + 1) % 4
end

local function left()
    turtle.turnLeft()
    heading = (heading + 3) % 4
end

local function around()
    turtle.turnRight()
    turtle.turnRight()
    heading = (heading + 2) % 4
end

local function face(dir)
    local d = (dir - heading) % 4
    if d == 1 then
        right()
    elseif d == 2 then
        around()
    elseif d == 3 then
        left()
    end
end

local function isRoadBelow()
    local ok, data = turtle.inspectDown()
    return ok and data.name == ROAD
end

-- Check the floor of the next block.
-- The turtle temporarily moves one block, checks the floor,
-- then returns to its original position and direction.
local function roadAhead()
    if turtle.detect() then
        return false
    end

    if not turtle.forward() then
        return false
    end

    local result = isRoadBelow()

    turtle.back()
    return result
end

-- Find road around the turtle.
-- Priority: forward -> left -> right -> back.
local function findRoad()
    local original = heading
    local order = {
        original,
        (original + 3) % 4,
        (original + 1) % 4,
        (original + 2) % 4
    }

    for _, dir in ipairs(order) do
        face(dir)

        if roadAhead() then
            return dir
        end
    end

    face(original)
    return nil
end

print("WALK5 - ROAD WALKER")
print("Road: polished andesite")
print("")

if not isRoadBelow() then
    print("ERROR: NOT ON ROAD")
    print("Place turtle on polished andesite.")
    return
end

print("ROAD FOUND")
sleep(1)
term.clear()
term.setCursorPos(1, 1)

while true do
    -- We must always be standing on the road.
    if not isRoadBelow() then
        print("ROAD LOST - STOPPED")
        break
    end

    -- Only choose a direction after checking that its NEXT floor block
    -- is polished andesite.
    local dir = findRoad()

    if dir == nil then
        print("NO ROAD AROUND")
        print("Turtle stopped.")
        break
    end

    face(dir)

    -- The direction has already been checked, but check the obstacle once
    -- more immediately before moving.
    if turtle.detect() then
        sleep(0.2)
    else
        if not turtle.forward() then
            sleep(0.2)
        end
    end

    sleep(0.2)
end
