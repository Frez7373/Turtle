-- =========================================

local ROAD = "minecraft:polished_andesite"
local heading = 0
local stuckCount = 0

local function right()
    turtle.turnRight()
    heading = (heading + 1) % 4
end

local function left()
    turtle.turnLeft()
    heading = (heading + 3) % 4
end

local function backTurn()
    turtle.turnRight()
    turtle.turnRight()
    heading = (heading + 2) % 4
end

local function face(dir)
    local d = (dir - heading) % 4
    if d == 1 then
        right()
    elseif d == 2 then
        backTurn()
    elseif d == 3 then
        left()
    end
end

local function roadBelow()
    local ok, data = turtle.inspectDown()
    return ok and data.name == ROAD
end

-- Move one block, then verify that the new block is road.
local function step()
    if turtle.detect() then
        return false
    end

    if not turtle.forward() then
        return false
    end

    return roadBelow()
end

-- Test one direction without permanently moving.
local function test(dir)
    face(dir)

    if turtle.detect() then
        return false
    end

    if not turtle.forward() then
        return false
    end

    local good = roadBelow()
    turtle.back()
    return good
end

-- Find possible road directions.
-- IMPORTANT: this returns WORLD/FACING directions, not relative ones.
local function findRoad()
    local dirs = {}

    -- Current direction first.
    local candidates = {
        heading,
        (heading + 3) % 4,
        (heading + 1) % 4,
        (heading + 2) % 4
    }

    for _, dir in ipairs(candidates) do
        if test(dir) then
            table.insert(dirs, dir)
        end
    end

    return dirs
end

print("WALK5 START")
print("Road: polished andesite")

if not roadBelow() then
    print("ERROR: turtle is not on polished andesite!")
    print("Put the turtle on the road and run walk5 again.")
    return
end

print("Road detected.")
sleep(1)
term.clear()
term.setCursorPos(1, 1)

while true do
    -- Always stay on the road.
    if not roadBelow() then
        print("Lost road - stopping.")
        print("Turtle position is not on polished andesite.")
        break
    end

    -- First try the current direction without turning.
    if not turtle.detect() then
        if turtle.forward() then
            stuckCount = 0
            sleep(0.2)
        else
            stuckCount = stuckCount + 1
        end
    else
        stuckCount = stuckCount + 1
    end

    -- If forward is blocked, or movement failed, find a new road direction.
    if stuckCount > 0 then
        local roads = findRoad()

        if #roads > 0 then
            -- Prefer a direction other than going straight back.
            local chosen = roads[1]

            if #roads > 1 then
                for _, dir in ipairs(roads) do
                    if dir ~= ((heading + 2) % 4) then
                        chosen = dir
                        break
                    end
                end
            end

            face(chosen)

            if not turtle.detect() and turtle.forward() then
                stuckCount = 0
            else
                stuckCount = 1
            end
        else
            -- No neighboring road. Turn once and retry later.
            -- This is NOT a continuous spin.
            right()
            sleep(0.5)
        end
    end

    sleep(0.15)
end
