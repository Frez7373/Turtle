local ROAD = "minecraft:polished_andesite"
local heading = 0

math.randomseed(os.epoch("utc"))

local function turnRight()
    turtle.turnRight()
    heading = (heading + 1) % 4
end

local function turnLeft()
    turtle.turnLeft()
    heading = (heading + 3) % 4
end

local function turnAround()
    turtle.turnRight()
    turtle.turnRight()
    heading = (heading + 2) % 4
end

local function turnTo(dir)
    local diff = (dir - heading) % 4
    if diff == 1 then
        turnRight()
    elseif diff == 2 then
        turnAround()
    elseif diff == 3 then
        turnLeft()
    end
end

local function isRoadBelow()
    local ok, block = turtle.inspectDown()
    return ok and block and block.name == ROAD
end

local function roadAhead()
    if turtle.detect() then
        return false
    end

    if not turtle.forward() then
        return false
    end

    local road = isRoadBelow()
    turtle.back()
    return road
end

local function checkDirection(dir)
    turnTo(dir)
    return roadAhead()
end

local function chooseDirection()
    local forward = heading
    local left = (heading + 3) % 4
    local right = (heading + 1) % 4
    local back = (heading + 2) % 4

    if checkDirection(forward) then
        return forward
    end

    if math.random(1, 2) == 1 then
        if checkDirection(left) then
            return left
        end
        if checkDirection(right) then
            return right
        end
    else
        if checkDirection(right) then
            return right
        end
        if checkDirection(left) then
            return left
        end
    end

    if checkDirection(back) then
        return back
    end

    return nil
end

local function moveOneBlock(dir)
    turnTo(dir)

    if turtle.detect() then
        return false
    end

    return turtle.forward()
end

print("================================")
print(" WALK5 - ROAD WALKER")
print("================================")
print("Road: polished andesite")
print("")

if isRoadBelow() then
    print("Road detected!")
else
    print("WARNING: turtle is not on road")
    print("Place turtle on polished andesite")
end

sleep(1)
term.clear()
term.setCursorPos(1, 1)

while true do
    if not isRoadBelow() then
        print("Searching for road...")

        local found = false
        local dirs = {
            heading,
            (heading + 1) % 4,
            (heading + 3) % 4,
            (heading + 2) % 4
        }

        for _, dir in ipairs(dirs) do
            if checkDirection(dir) then
                if moveOneBlock(dir) then
                    found = true
                    break
                end
            end
        end

        if not found then
            sleep(1)
        end
    else
        local dir = chooseDirection()

        if dir ~= nil then
            if not moveOneBlock(dir) then
                sleep(0.2)
            end
        else
            turnAround()
            if not turtle.detect() then
                turtle.forward()
            end
        end
    end

    sleep(0.25)
end
