-- START
--------------------------------------------------

term.clear()
term.setCursorPos(1, 1)

print("SMART CITY ROAD WALKER")
print("======================")
print("")
print("Road:")
print("Polished Andesite")
print("")
print("Scanning road network...")
print("")

sleep(1)

--------------------------------------------------
-- START CONDITION
--------------------------------------------------

if not isRoadUnderTurtle() then

    print("ERROR:")
    print("Turtle is not on a road!")
    print("")
    print("Place turtle on")
    print("polished andesite.")

    while true do
        sleep(10)
    end
end

markVisited()

print("Road detected!")
print("Wandering...")
print("")

--------------------------------------------------
-- MAIN LOOP
--------------------------------------------------

while true do

    ------------------------------------------------
    -- Scan around us
    ------------------------------------------------

    local roads = scanRoad()

    ------------------------------------------------
    -- Select destination
    ------------------------------------------------

    local direction = choosePath(roads)

    ------------------------------------------------
    -- Move
    ------------------------------------------------

    if direction then

        local success = moveDirection(direction)

        if not success then
            sleep(0.5)
        end

    else

        ------------------------------------------------
        -- No normal path.
        -- Rotate and search for another road section.
        ------------------------------------------------

        print("Dead end / blocked road")

        if not escapeRoad() then

            -- Nothing found.
            -- Slowly rotate and retry.
            turtle.turnRight()
            heading = (heading + 1) % 4

            sleep(0.5)
        end
    end

    ------------------------------------------------
    -- Prevent visited table from growing forever
    ------------------------------------------------

    local count = 0

    for _ in pairs(visited) do
        count = count + 1

        if count > 10000 then
            visited = {}
            markVisited()
            break
        end
    end

    sleep(STEP_DELAY)
end
