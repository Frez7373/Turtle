-- SMART CITY ROAD WALKER v3
-- CC:Tweaked
--
-- WALK ONLY ON POLISHED ANDESITE
--
-- Important:
-- A turtle cannot inspect the floor of the NEXT block without moving onto it.
-- Therefore this version tests a direction by moving one block, checking
-- inspectDown(), and immediately returning when that block is not road.
-- It never accepts a direction unless the destination floor is polished andesite.
--
-- Features:
-- * Only walks on polished andesite
-- * Handles roads of different widths
-- * Handles turns and intersections
-- * Handles roads that zig-zag
-- * Strong anti-spinning / anti-loop logic
-- * Prefers straight, then left/right, then backwards
-- * Does not randomly rotate forever

local ROAD = "minecraft:polished_andesite"

local STEP_DELAY = 0.18
local TURN_DELAY = 0.04
local RECENT_MEMORY = 30

--------------------------------------------------
-- DIRECTIONS
--------------------------------------------------

-- 0 = North
-- 1 = East
-- 2 = South
-- 3 = West

local heading = 0

local dx = {
    [0] = 0,
    [1] = 1,
    [2] = 0,
    [3] = -1
}

local dz = {
    [0] = -1,
    [1] = 0,
    [2] = 1,
    [3] = 0
}

--------------------------------------------------
-- LOCAL POSITION / MEMORY
--------------------------------------------------

local posX = 0
local posZ = 0

local visited = {}
local history = {}

local function key(x, z)
    return tostring(x) .. ":" .. tostring(z)
end

local function markVisited(x, z)
    visited[key(x, z)] = true
end

local function wasVisited(x, z)
    return visited[key(x, z)] == true
end

local function rememberPosition()
    table.insert(history, key(posX, posZ))

    if #history > RECENT_MEMORY then
        table.remove(history, 1)
    end
end

local function recentlyVisited(x, z)
    local wanted = key(x, z)

    for i = #history, 1, -1 do
        if history[i] == wanted then
            return true
        end
    end

    return false
end

--------------------------------------------------
-- ROAD UNDER TURTLE
--------------------------------------------------

local function isRoadUnderTurtle()
    local ok, data = turtle.inspectDown()

    return ok and data and data.name == ROAD
end

--------------------------------------------------
-- TURNING
--------------------------------------------------

local function turnRight()
    turtle.turnRight()
    heading = (heading + 1) % 4
    sleep(TURN_DELAY)
end

local function turnLeft()
    turtle.turnLeft()
    heading = (heading + 3) % 4
    sleep(TURN_DELAY)
end

local function turnTo(target)
    local difference = (target - heading) % 4

    if difference == 1 then
        turnRight()

    elseif difference == 2 then
        turnRight()
        turnRight()

    elseif difference == 3 then
        turnLeft()
    end
end

--------------------------------------------------
-- TEST A DIRECTION
--------------------------------------------------

-- Returns TRUE only when the block one step ahead has
-- polished andesite under the turtle.
--
-- The turtle temporarily moves one block to perform the
-- floor check, then returns to its original position.

local function testDirection(dir)
    local oldHeading = heading

    turnTo(dir)

    -- A block directly in front can physically block the move.
    if turtle.detect() then
        turnTo(oldHeading)
        return false
    end

    -- Move one block only for the floor test.
    if not turtle.forward() then
        turnTo(oldHeading)
        return false
    end

    local road = isRoadUnderTurtle()

    -- Always return to the original position after the test.
    if not turtle.back() then
        -- Extremely unusual, but do not start spinning.
        turnTo(oldHeading)
        return false
    end

    turnTo(oldHeading)

    return road
end

--------------------------------------------------
-- SCAN ALL FOUR DIRECTIONS
--------------------------------------------------

local function scanRoad()
    local options = {}

    -- Test in physical preference order:
    -- straight, right, left, backwards.
    local relative = {
        0, 1, 3, 2
    }

    for _, offset in ipairs(relative) do
        local dir = (heading + offset) % 4

        if testDirection(dir) then
            local nx = posX + dx[dir]
            local nz = posZ + dz[dir]

            table.insert(options, {
                dir = dir,
                x = nx,
                z = nz,
                visited = wasVisited(nx, nz),
                recent = recentlyVisited(nx, nz),
                offset = offset
            })
        end
    end

    return options
end

--------------------------------------------------
-- CHOOSE PATH
--------------------------------------------------

local function choosePath(options)
    if #options == 0 then
        return nil
    end

    -- 1. Prefer a fresh road straight ahead.
    for _, option in ipairs(options) do
        if option.offset == 0 and not option.visited and not option.recent then
            return option.dir
        end
    end

    -- 2. Prefer any fresh road that is not backwards.
    for _, option in ipairs(options) do
        if option.offset ~= 2 and not option.visited and not option.recent then
            return option.dir
        end
    end

    -- 3. If the road was visited before, still prefer
    -- straight/right/left before making a U-turn.
    for _, option in ipairs(options) do
        if option.offset ~= 2 then
            return option.dir
        end
    end

    -- 4. Only possible road is backwards.
    return options[1].dir
end

--------------------------------------------------
-- MOVE ONE STEP
--------------------------------------------------

local function moveDirection(dir)
    turnTo(dir)

    -- Final safety check immediately before moving.
    if turtle.detect() then
        return false
    end

    if not turtle.forward() then
        return false
    end

    -- The turtle has moved. Verify the FLOOR immediately.
    if not isRoadUnderTurtle() then
        -- Never continue on a non-road block.
        turtle.back()
        return false
    end

    posX = posX + dx[dir]
    posZ = posZ + dz[dir]

    markVisited(posX, posZ)
    rememberPosition()

    sleep(STEP_DELAY)

    return true
end

--------------------------------------------------
-- DEAD END HANDLER
--------------------------------------------------

local function handleDeadEnd()
    -- There are no polished-andesite blocks next to us.
    -- Do NOT spin forever.
    -- The turtle simply turns around once and checks again.
    local opposite = (heading + 2) % 4

    if testDirection(opposite) then
        return moveDirection(opposite)
    end

    -- Truly isolated: stop safely instead of rotating forever.
    print("No connected polished andesite road.")
    print("Turtle stopped safely.")

    while true do
        sleep(10)
    end
end

--------------------------------------------------
-- START
--------------------------------------------------

math.randomseed(os.epoch("utc"))

term.clear()
term.setCursorPos(1, 1)

print("SMART CITY ROAD WALKER v3")
print("=========================")
print("")
print("Road: Polished Andesite")
print("")

if not isRoadUnderTurtle() then
    print("ERROR: Turtle is not on polished andesite.")
    print("")
    print("Place the turtle on a road and restart.")

    while true do
        sleep(10)
    end
end

markVisited(posX, posZ)
rememberPosition()

print("Road detected!")
print("Walking...")
print("")

sleep(1)

--------------------------------------------------
-- MAIN LOOP
--------------------------------------------------

while true do
    local roads = scanRoad()
    local direction = choosePath(roads)

    if direction then
        local success = moveDirection(direction)

        if not success then
            -- Something changed between scan and move.
            -- Re-scan instead of rotating endlessly.
            sleep(0.15)
        end
    else
        handleDeadEnd()
    end

    sleep(0.05)
end
