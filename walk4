-- WALK4 - POLISHED ANDESITE ROAD WALKER
-- CC:Tweaked
--
-- The turtle ONLY accepts a position when the block below it
-- is minecraft:polished_andesite.
--
-- Movement is deliberately simple:
--   1. Turn to a candidate direction.
--   2. Move one block.
--   3. Check the block under the turtle.
--   4. If it is polished andesite, stay there.
--   5. Otherwise move back and try another direction.
--
-- This avoids endless spinning and avoids relying on an
-- imaginary map of the road.

local ROAD = "minecraft:polished_andesite"
local STEP_DELAY = 0.15
local TURN_DELAY = 0.04
local MAX_HISTORY = 50

--------------------------------------------------
-- DIRECTIONS
--------------------------------------------------

-- 0 = North
-- 1 = East
-- 2 = South
-- 3 = West

local heading = 0

local dx = { [0]=0, [1]=1, [2]=0, [3]=-1 }
local dz = { [0]=-1, [1]=0, [2]=1, [3]=0 }

--------------------------------------------------
-- LOCAL MEMORY
--------------------------------------------------

local posX = 0
local posZ = 0
local visited = {}
local history = {}

local function key(x, z)
    return tostring(x) .. ":" .. tostring(z)
end

local function markVisited()
    visited[key(posX, posZ)] = true

    table.insert(history, key(posX, posZ))
    if #history > MAX_HISTORY then
        table.remove(history, 1)
    end
end

local function wasVisited(x, z)
    return visited[key(x, z)] == true
end

local function recentlyVisited(x, z)
    local wanted = key(x, z)

    for i = #history, 1, -1 do
        if history[i] == wanted then
            return true
        end
    end

    return false
end

--------------------------------------------------
-- ROAD CHECK
--------------------------------------------------

local function isRoadHere()
    local ok, data = turtle.inspectDown()
    return ok and data and data.name == ROAD
end

--------------------------------------------------
-- TURNING
--------------------------------------------------

local function turnRight()
    turtle.turnRight()
    heading = (heading + 1) % 4
    sleep(TURN_DELAY)
end

local function turnLeft()
    turtle.turnLeft()
    heading = (heading + 3) % 4
    sleep(TURN_DELAY)
end

local function turnBack()
    turtle.turnRight()
    turtle.turnRight()
    heading = (heading + 2) % 4
    sleep(TURN_DELAY)
end

--------------------------------------------------
-- TRY TO MOVE ONE BLOCK
--------------------------------------------------

local function tryMove()
    -- IMPORTANT:
    -- Do not use turtle.detect() here.
    -- Just let turtle.forward() tell us whether movement is possible.

    if not turtle.forward() then
        return false
    end

    sleep(0.03)

    -- The ONLY thing that makes a location valid:
    -- polished andesite directly underneath the turtle.
    if isRoadHere() then
        posX = posX + dx[heading]
        posZ = posZ + dz[heading]
        markVisited()
        sleep(STEP_DELAY)
        return true
    end

    -- Not a road. Immediately leave that block.
    turtle.back()
    sleep(0.03)

    return false
end

--------------------------------------------------
-- TRY A RELATIVE DIRECTION
--------------------------------------------------

local function tryRelative(offset)
    if offset == 0 then
        return tryMove()
    elseif offset == 1 then
        turnRight()
        return tryMove()
    elseif offset == 3 then
        turnLeft()
        return tryMove()
    elseif offset == 2 then
        turnBack()
        return tryMove()
    end

    return false
end

--------------------------------------------------
-- PICK NEXT DIRECTION
--------------------------------------------------

local function chooseMove()
    -- Prefer:
    -- 1. straight
    -- 2. right
    -- 3. left
    -- 4. backwards
    --
    -- We do not randomly spin.

    local current = heading

    -- Straight first, but avoid a recently visited position
    -- when another direction exists.
    local candidates = {0, 1, 3, 2}

    local fallback = nil

    for _, offset in ipairs(candidates) do
        local dir = (current + offset) % 4
        local nx = posX + dx[dir]
        local nz = posZ + dz[dir]

        if not wasVisited(nx, nz) and not recentlyVisited(nx, nz) then
            -- Save the first genuinely new direction.
            -- Actual road verification happens in tryMove().
            if tryRelative(offset) then
                return true
            end

            -- tryRelative changes heading only if offset is 1/3/2.
            -- Restore our original heading before trying the next option.
            while heading ~= current do
                local difference = (current - heading) % 4
                if difference == 1 then
                    turnRight()
                elseif difference == 3 then
                    turnLeft()
                else
                    turnBack()
                end
            end
        end
    end

    -- If no new road was found, allow an old road.
    for _, offset in ipairs(candidates) do
        if tryRelative(offset) then
            return true
        end

        while heading ~= current do
            local difference = (current - heading) % 4
            if difference == 1 then
                turnRight()
            elseif difference == 3 then
                turnLeft()
            else
                turnBack()
            end
        end
    end

    return false
end

--------------------------------------------------
-- START
--------------------------------------------------

term.clear()
term.setCursorPos(1, 1)

print("SMART CITY ROAD WALKER")
print("======================")
print("")
print("Road: Polished Andesite")
print("")

if not isRoadHere() then
    print("ERROR")
    print("The turtle is not on polished andesite.")
    print("")
    print("Place the turtle directly on the road.")

    while true do
        sleep(10)
    end
end

markVisited()

print("Road detected!")
print("Walking...")

sleep(1)

--------------------------------------------------
-- MAIN LOOP
--------------------------------------------------

while true do
    local moved = chooseMove()

    if not moved then
        -- At a completely isolated road block.
        -- Do not spin forever.
        print("Road ended. Waiting...")
        sleep(2)
    end

    sleep(0.05)
end
