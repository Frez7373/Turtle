-- SMART CITY ROAD WALKER v2
-- CC:Tweaked
-- Walks ONLY on polished andesite roads
--
-- This version does NOT move while scanning.
-- It turns in place, inspects the block in each direction,
-- and only moves when the destination block is polished andesite.
--
-- Supports:
-- * Different road widths
-- * Intersections
-- * Turns
-- * Zig-zag / diagonal-looking roads made from connected blocks
-- * Random wandering without leaving the road
-- * Anti-loop behavior

local ROAD = "minecraft:polished_andesite"

local STEP_DELAY = 0.18
local TURN_DELAY = 0.05
local LOOP_MEMORY = 80

--------------------------------------------------
-- DIRECTIONS
--------------------------------------------------

-- 0 = North
-- 1 = East
-- 2 = South
-- 3 = West

local heading = 0

--------------------------------------------------
-- POSITION MEMORY
--------------------------------------------------

-- This is only the turtle's local map.
-- It does not need real Minecraft coordinates.
local posX = 0
local posZ = 0

local dx = {
    [0] = 0,
    [1] = 1,
    [2] = 0,
    [3] = -1
}

local dz = {
    [0] = -1,
    [1] = 0,
    [2] = 1,
    [3] = 0
}

local visited = {}
local history = {}

--------------------------------------------------
-- BASIC HELPERS
--------------------------------------------------

local function key(x, z)
    return tostring(x) .. ":" .. tostring(z)
end

local function markVisited(x, z)
    visited[key(x, z)] = true
end

local function wasVisited(x, z)
    return visited[key(x, z)] == true
end

local function rememberPosition()
    local k = key(posX, posZ)
    table.insert(history, k)

    if #history > LOOP_MEMORY then
        table.remove(history, 1)
    end
end

local function recentlyVisited(x, z)
    local k = key(x, z)

    for i = #history, math.max(1, #history - 25), -1 do
        if history[i] == k then
            return true
        end
    end

    return false
end

--------------------------------------------------
-- CURRENT ROAD CHECK
--------------------------------------------------

local function isRoadUnderTurtle()
    local ok, data = turtle.inspectDown()

    if not ok or not data then
        return false
    end

    return data.name == ROAD
end

--------------------------------------------------
-- LOOK IN FRONT
--------------------------------------------------

local function isRoadInDirection(dir)
    local oldHeading = heading

    -- Turn toward the direction we want to inspect.
    local difference = (dir - heading) % 4

    if difference == 1 then
        turtle.turnRight()
        heading = (heading + 1) % 4

    elseif difference == 2 then
        turtle.turnRight()
        turtle.turnRight()
        heading = (heading + 2) % 4

    elseif difference == 3 then
        turtle.turnLeft()
        heading = (heading + 3) % 4
    end

    sleep(TURN_DELAY)

    local ok, data = turtle.inspect()

    local road = false

    if ok and data and data.name == ROAD then
        road = true
    end

    -- Restore original heading.
    local restore = (oldHeading - heading) % 4

    if restore == 1 then
        turtle.turnRight()
        heading = (heading + 1) % 4

    elseif restore == 2 then
        turtle.turnRight()
        turtle.turnRight()
        heading = (heading + 2) % 4

    elseif restore == 3 then
        turtle.turnLeft()
        heading = (heading + 3) % 4
    end

    sleep(TURN_DELAY)

    return road
end

--------------------------------------------------
-- TURN TO DIRECTION
--------------------------------------------------

local function turnTo(target)
    local difference = (target - heading) % 4

    if difference == 1 then
        turtle.turnRight()
        heading = (heading + 1) % 4

    elseif difference == 2 then
        turtle.turnRight()
        turtle.turnRight()
        heading = (heading + 2) % 4

    elseif difference == 3 then
        turtle.turnLeft()
        heading = (heading + 3) % 4
    end

    if difference ~= 0 then
        sleep(TURN_DELAY)
    end
end

--------------------------------------------------
-- SCAN ROAD AROUND TURTLE
--------------------------------------------------

local function scanRoad()
    local options = {}

    for dir = 0, 3 do
        if isRoadInDirection(dir) then
            local nx = posX + dx[dir]
            local nz = posZ + dz[dir]

            table.insert(options, {
                dir = dir,
                x = nx,
                z = nz,
                visited = wasVisited(nx, nz),
                recent = recentlyVisited(nx, nz)
            })
        end
    end

    return options
end

--------------------------------------------------
-- REMOVE BAD LOOP CHOICES
--------------------------------------------------

local function filterFresh(options)
    local fresh = {}

    for _, option in ipairs(options) do
        if not option.visited and not option.recent then
            table.insert(fresh, option)
        end
    end

    if #fresh > 0 then
        return fresh
    end

    -- Second chance: any unvisited road, even if recently visited.
    fresh = {}

    for _, option in ipairs(options) do
        if not option.visited then
            table.insert(fresh, option)
        end
    end

    return fresh
end

--------------------------------------------------
-- CHOOSE PATH
--------------------------------------------------

local function choosePath(options)
    if #options == 0 then
        return nil
    end

    local opposite = (heading + 2) % 4

    ------------------------------------------------
    -- 1. Fresh road straight ahead.
    ------------------------------------------------

    for _, option in ipairs(options) do
        if option.dir == heading and not option.visited and not option.recent then
            return option.dir
        end
    end

    ------------------------------------------------
    -- 2. Any other fresh road.
    ------------------------------------------------

    local fresh = filterFresh(options)

    if #fresh > 0 then
        -- Avoid an immediate U-turn when another road exists.
        local noReverse = {}

        for _, option in ipairs(fresh) do
            if option.dir ~= opposite then
                table.insert(noReverse, option)
            end
        end

        if #noReverse > 0 then
            fresh = noReverse
        end

        return fresh[math.random(1, #fresh)].dir
    end

    ------------------------------------------------
    -- 3. Everything nearby was visited.
    -- Prefer straight, then avoid reversing.
    ------------------------------------------------

    for _, option in ipairs(options) do
        if option.dir == heading then
            return option.dir
        end
    end

    local noReverse = {}

    for _, option in ipairs(options) do
        if option.dir ~= opposite then
            table.insert(noReverse, option)
        end
    end

    if #noReverse > 0 then
        return noReverse[math.random(1, #noReverse)].dir
    end

    ------------------------------------------------
    -- 4. Only remaining road is behind us.
    ------------------------------------------------

    return options[1].dir
end

--------------------------------------------------
-- MOVE ONTO ROAD
--------------------------------------------------

local function moveDirection(dir)
    -- IMPORTANT: this function only moves after the target
    -- direction has already been confirmed to be polished andesite.
    turnTo(dir)

    local ok, data = turtle.inspect()

    if not ok or not data or data.name ~= ROAD then
        return false
    end

    if turtle.detect() then
        return false
    end

    if not turtle.forward() then
        return false
    end

    posX = posX + dx[dir]
    posZ = posZ + dz[dir]

    markVisited(posX, posZ)
    rememberPosition()

    sleep(STEP_DELAY)

    return true
end

--------------------------------------------------
-- DEAD END HANDLING
--------------------------------------------------

local function handleDeadEnd()
    -- At a real dead end the only road will normally be behind us.
    -- Scan again rather than spinning forever.
    local options = scanRoad()

    if #options > 0 then
        local direction = choosePath(options)

        if direction then
            return moveDirection(direction)
        end
    end

    return false
end

--------------------------------------------------
-- START
--------------------------------------------------

math.randomseed(os.epoch("utc"))

term.clear()
term.setCursorPos(1, 1)

print("SMART CITY ROAD WALKER")
print("======================")
print("")
print("Road: polished andesite")
print("")
print("Checking starting position...")
print("")

sleep(0.7)

--------------------------------------------------
-- START CONDITION
--------------------------------------------------

if not isRoadUnderTurtle() then
    print("ERROR")
    print("Turtle is not on a road!")
    print("")
    print("Place the turtle on")
    print("polished andesite.")

    while true do
        sleep(10)
    end
end

markVisited(posX, posZ)
rememberPosition()

print("Road detected!")
print("Walking on road...")
print("")

--------------------------------------------------
-- MAIN LOOP
--------------------------------------------------

while true do
    local roads = scanRoad()
    local direction = choosePath(roads)

    if direction then
        local success = moveDirection(direction)

        if not success then
            sleep(0.25)
        end
    else
        -- No road neighbor found.
        -- Wait and rescan instead of blindly rotating.
        sleep(0.4)
        handleDeadEnd()
    end

    ------------------------------------------------
    -- Keep memory bounded.
    ------------------------------------------------

    local count = 0

    for _ in pairs(visited) do
        count = count + 1
    end

    if count > 12000 then
        visited = {}
        markVisited(posX, posZ)
    end

    sleep(STEP_DELAY)
end
